/* 
==============================================================================
MEASURES: US LOGISTICS PERFORMANCE & SHIPMENT AUDIT
==============================================================================
*/

-- 1. Total Spend ($)
Total Spend = 
SUM('logistics_shipments_dataset'[Spend])


-- 2. Average Transit Days
Avg Transit Days = 
AVERAGE('logistics_shipments_dataset'[Transit_Days])


-- 3. Delayed Shipments Count
Delayed Shipments = 
CALCULATE(
    COUNTROWS('logistics_shipments_dataset'),
    'logistics_shipments_dataset'[Status] = "DELAYED"
)


-- 4. Delayed Rate %
Delayed Rate % = 
DIVIDE(
    [Delayed Shipments], 
    COUNTROWS('logistics_shipments_dataset'), 
    0
)


-- 5. On-Time / Delivered Rate %
On-Time Rate % = 
DIVIDE(
    CALCULATE(
        COUNTROWS('logistics_shipments_dataset'), 
        'logistics_shipments_dataset'[Status] = "DELIVERED"
    ),
    COUNTROWS('logistics_shipments_dataset'),
    0
)


-- 6. Total Shipment Volume
Total Shipments = 
COUNTROWS('logistics_shipments_dataset')