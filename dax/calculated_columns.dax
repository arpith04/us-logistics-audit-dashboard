/* 
==============================================================================
CALCULATED COLUMNS: US LOGISTICS PERFORMANCE & SHIPMENT AUDIT
==============================================================================
*/

-- 1. Binary Delay Flag (1 for Delayed, 0 for On-Time/Other)
Is_Delayed = 
IF(
    'logistics_shipments_dataset'[Status] = "DELAYED", 
    1, 
    0
)


-- 2. Transit Risk Category
Transit_Risk_Level = 
SWITCH(
    TRUE(),
    'logistics_shipments_dataset'[Transit_Days] > 5, "High Risk",
    'logistics_shipments_dataset'[Transit_Days] >= 3, "Medium Risk",
    "Low Risk"
)